{
  "name": "opencode-tokenwatch",
  "version": "0.3.2",
  "description": "Real-time token usage, cache analytics & performance dashboard plugin for OpenCode CLI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.jsx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "release:check": "node ./scripts/publish-check.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "opencode-plugin",
    "tokens",
    "usage",
    "stats",
    "sqlite",
    "analytics",
    "tui"
  ],
  "license": "MIT",
  "author": "TTWK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TTWK/opencode-tokenwatch.git"
  },
  "bugs": {
    "url": "https://github.com/TTWK/opencode-tokenwatch/issues"
  },
  "homepage": "https://github.com/TTWK/opencode-tokenwatch#readme",
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@opentui/core": "^0.2.9",
    "@opentui/keymap": "^0.2.9",
    "@opentui/solid": "^0.2.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
