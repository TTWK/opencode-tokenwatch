{
  "name": "opencode-tokenwatch",
  "version": "0.6.0",
  "description": "Real-time token usage, cache analytics & performance dashboard plugin for OpenCode CLI",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "config": {
        "enabled": true
      }
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tui.ts",
    "index.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node build.tui.mjs",
    "release:check": "node ./scripts/publish-check.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "opencode-plugin",
    "tokens",
    "usage",
    "stats",
    "sqlite",
    "analytics",
    "tui"
  ],
  "license": "MIT",
  "author": "TTWK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TTWK/opencode-tokenwatch.git"
  },
  "bugs": {
    "url": "https://github.com/TTWK/opencode-tokenwatch/issues"
  },
  "homepage": "https://github.com/TTWK/opencode-tokenwatch#readme",
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.30",
    "@opentui/core": "^0.5.11",
    "@opentui/keymap": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "esbuild-plugin-solid": "^0.5.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0",
    "@opentui/core": ">=0.5.0",
    "@opentui/solid": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  }
}
